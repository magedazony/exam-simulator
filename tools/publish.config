# Settings for publish.bat. To use the tool in another project, copy the tools folder there and change these lines.
# repo   = the project's GitHub address
# site   = the live site address (leave empty to skip waiting for the deploy)
# health = a page on the site that answers {"version": "<commit>"}; leave as is if unsure
repo=https://github.com/magedazony/exam-simulator.git
site=https://exam-simulator-k925.onrender.com
health=/api/v1/health
