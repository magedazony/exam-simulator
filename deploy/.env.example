# Copy to deploy/.env and fill in. Never commit the filled-in file.
# Generate secrets with: openssl rand -hex 32

# ---- site
# Product name in the browser, on the home screen and in emails. Must not contain PMP or PMI.
APP_NAME=Exam Simulator
APP_SHORT_NAME=Exam Sim
DOMAIN=exam.example.com
ACME_EMAIL=ops@example.com
PUBLIC_URL=https://exam.example.com
NODE_ENV=production

# ---- security (required)
TOKEN_SECRET=
# Name shown in authenticator apps for staff two-factor sign-in.
MFA_ISSUER=Exam Simulator

# ---- database
PGDATABASE=exam
PGUSER=exam
PGPASSWORD=
# For a managed database instead of the db container: set PGHOST, and
# PGSSLMODE=verify-full with PGSSLROOTCERT=/path/to/provider-ca.pem
PGPOOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=30000

# ---- email (required in production): any SMTP provider
MAIL_MODE=smtp
MAIL_FROM=Exam Simulator <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
# starttls (587) or tls (465)
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=

# ---- product rules
# Practice answers a day without a pass.
FREE_DAILY_PRACTICE=15
# Sign-in and sign-up attempts per minute per client address.
AUTH_RATE_LIMIT=10
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# ---- Android app (see android/README.md and PUBLISH.md)
# Package of the Google Play app, and SHA-256 fingerprints of the app signing
# key and the upload key (Play Console → App integrity), comma separated.
ANDROID_PACKAGE=
ANDROID_CERT_SHA256=
# Google service-account key that lets the server verify Google Play purchases.
# With Docker Compose, put the file in deploy/secrets/ and use the path below.
GOOGLE_SERVICE_ACCOUNT_FILE=

# ---- backups (docker compose backup service)
BACKUP_HOST_DIR=./backups
BACKUP_KEEP_DAYS=14
